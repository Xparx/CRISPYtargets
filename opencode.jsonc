{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "edit", "resource": "AGENTS.md", "effect": "deny" },
    { "action": "edit", "resource": "llm_base/RULES.org", "effect": "deny" },
    { "action": "edit", "resource": "llm_base/roles.org", "effect": "deny" },
    { "action": "edit", "resource": "opencode.jsonc", "effect": "deny" },
    { "action": "edit", "resource": ".opencode/commands/commitmsg.md", "effect": "deny" }
  ]
}
